{
  "name": "mikage-creative-os",
  "version": "1.0.0",
  "description": "Mikage — Controlled Creative Operating System. Identity-first AI render pipeline.",
  "main": "core/orchestration/orchestrator.js",
  "scripts": {
    "start": "node interfaces/api/server.js",
    "orchestrator": "node core/orchestration/orchestrator.js",
    "mikage:start": "node MIKAGE/index.js",
    "test": "node scripts/run_all_tests.js",
    "test:invariants": "jest tests/invariants/system_invariants.test.js --runInBand",
    "test:mikage": "node MIKAGE/mikage.test.js",
    "handoff:build": "node tools/handoff/refresh_handoff_pack.js",
    "handoff:refresh": "node tools/handoff/refresh_handoff_pack.js",
    "handoff:validate": "node tools/handoff/validate_handoff_pack.js",
    "handoff:memory-sync": "node tools/handoff/post_run_snapshot_refresh.js",
    "handoff:postrun": "node tools/handoff/post_run_snapshot_refresh.js",
    "test:core": "node core/state_machine.test.js",
    "test:control": "node control/precheck.test.js",
    "test:middleware": "node middleware/middleware.test.js",
    "test:translator": "node translator/translator_guard.test.js && node translator/ollama_translate.test.js",
    "test:render": "node render/render.test.js",
    "test:critic": "node critic/critic.test.js",
    "test:drift": "node drift/drift.test.js",
    "test:memory": "node memory/memory.test.js",
    "test:e2e": "node tests/e2e/orchestrator.test.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@google-cloud/discoveryengine": "^2.6.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@notionhq/client": "^5.14.0",
    "dotenv": "^17.3.1",
    "node-telegram-bot-api": "^0.67.0",
    "openai": "^6.33.0",
    "playwright": "^1.58.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "jest": "^30.3.0"
  }
}
