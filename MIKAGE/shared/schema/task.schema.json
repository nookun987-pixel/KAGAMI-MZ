{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mikage Task Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "lane",
    "objective",
    "constraints",
    "priority",
    "execution_plan",
    "success_criteria"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "type": "string",
      "enum": ["image", "cine", "game", "content", "ops"]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "type": "string"
    },
    "execution_plan": {
      "type": "object",
      "required": ["steps"],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "context": {
      "type": "object"
    }
  }
}
