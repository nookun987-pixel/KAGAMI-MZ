{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mikage-render-job-payload",
  "title": "Mikage Render Job Payload Contract",
  "description": "Structured payload for render job submission to Google Execution Lane",
  "type": "object",
  "required": [
    "job_id",
    "prompt",
    "negative_prompt",
    "seed",
    "aspect_ratio",
    "rag_enabled",
    "canon_flags",
    "output_path",
    "version"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0.0",
      "description": "Contract version for compatibility checking"
    },
    "job_id": {
      "type": "string",
      "description": "Unique job identifier",
      "examples": ["MASK_MACRO_001", "GOLDEN_CERAMIC_002"]
    },
    "shot_type": {
      "type": "string",
      "description": "Mikage shot classification",
      "examples": ["MASK_MACRO", "WEAPON_BASELINE", "ENTITY_MEDIUM"]
    },
    "entity_id": {
      "type": "string",
      "description": "Entity identifier for consistency tracking"
    },
    "prompt": {
      "type": "string",
      "minLength": 10,
      "description": "Final structured prompt for Imagen API",
      "examples": ["PRODUCT PHOTOGRAPHY - ceramic mask, hard-surface geometric chassis..."]
    },
    "negative_prompt": {
      "type": "string",
      "description": "Negative prompt content for Imagen API"
    },
    "seed": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 2147483647,
      "description": "Random seed for reproducibility. Null for random."
    },
    "seed_policy": {
      "type": "string",
      "enum": ["fixed", "random", "reproduction", "none"],
      "description": "Seed selection policy"
    },
    "aspect_ratio": {
      "type": "string",
      "enum": ["1:1", "3:4", "4:3", "9:16", "16:9", "21:9"],
      "description": "Output image aspect ratio"
    },
    "width": {
      "type": "integer",
      "minimum": 256,
      "maximum": 4096,
      "description": "Explicit width (alternative to aspect_ratio)"
    },
    "height": {
      "type": "integer",
      "minimum": 256,
      "maximum": 4096,
      "description": "Explicit height (alternative to aspect_ratio)"
    },
    "rag_enabled": {
      "type": "boolean",
      "description": "Whether to call Vertex RAG before rendering"
    },
    "rag_query": {
      "type": "string",
      "description": "Query string for RAG retrieval (if rag_enabled=true)"
    },
    "canon_flags": {
      "type": "object",
      "required": ["entity_first", "zone_locked", "material_locked"],
      "properties": {
        "entity_first": {
          "type": "boolean",
          "description": "Entity reconstruction priority flag"
        },
        "zone_locked": {
          "type": "boolean",
          "description": "Zone consistency enforced"
        },
        "material_locked": {
          "type": "boolean",
          "description": "Material canon enforced"
        },
        "reproduction_mode": {
          "type": "boolean",
          "description": "Strict reproduction requirements"
        },
        "anchor_images": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Paths to anchor images for img2img"
        }
      }
    },
    "output_path": {
      "type": "string",
      "description": "Base output directory path (platform-specific)",
      "examples": ["/content/outputs/MASK_MACRO_001", "gs://mikage-bucket/outputs/MASK_MACRO_001"]
    },
    "storage_backend": {
      "type": "string",
      "enum": ["local", "gcs", "drive"],
      "description": "Storage backend for outputs"
    },
    "imagen_config": {
      "type": "object",
      "description": "Imagen API specific configuration",
      "properties": {
        "model": {
          "type": "string",
          "enum": ["imagen-3.0-generate-001", "imagen-3.0-fast-generate-001"],
          "default": "imagen-3.0-generate-001"
        },
        "number_of_images": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "default": 1
        },
        "guidance_scale": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "default": 7.5
        },
        "safety_filter_level": {
          "type": "string",
          "enum": ["block_most", "block_some", "block_few"],
          "default": "block_some"
        },
        "person_generation": {
          "type": "string",
          "enum": ["allow_adult", "allow_all", "dont_allow"],
          "default": "dont_allow"
        }
      }
    },
    "control_core_metadata": {
      "type": "object",
      "description": "Metadata from control core for traceability",
      "properties": {
        "pipeline_version": { "type": "string" },
        "canon_version": { "type": "string" },
        "intake_timestamp": { "type": "string", "format": "date-time" },
        "spec_build_timestamp": { "type": "string", "format": "date-time" },
        "claude_model": { "type": "string" }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of job creation"
    }
  },
  "additionalProperties": false
}
