{
  "suite_name": "MIKAGE Meta Harness Strict Suite V2",
  "version": "2.0.0",
  "cases": [
    { "id": "TC001", "lane": "image", "category": "runtime", "description": "completed result with image artifact", "fail_if": ["decision != ALLOW"] },
    { "id": "TC002", "lane": "image", "category": "runtime", "description": "missing result.json", "fail_if": ["decision != REJECT"] },
    { "id": "TC003", "lane": "image", "category": "runtime", "description": "missing output.png", "fail_if": ["decision != REJECT"] },
    { "id": "TC004", "lane": "image", "category": "runtime", "description": "malformed result json", "fail_if": ["decision != REJECT"] },
    { "id": "TC005", "lane": "image", "category": "runtime", "description": "timeout before claim", "fail_if": ["failure_router.failure_type != timeout"] },
    { "id": "TC006", "lane": "image", "category": "runtime", "description": "stale claim no outputs", "fail_if": ["failure_router.failure_type != stale_claim"] },
    { "id": "TC007", "lane": "image", "category": "quality", "description": "validator fail with complete artifacts", "fail_if": ["failure_router.retry_allowed != false"] },
    { "id": "TC008", "lane": "image", "category": "runtime", "description": "claim exists then result arrives", "fail_if": ["decision != ALLOW"] },
    { "id": "TC009", "lane": "image", "category": "runtime", "description": "repair engine increases timeout", "fail_if": ["repair_action.actions missing increase_timeout"] },
    { "id": "TC010", "lane": "image", "category": "runtime", "description": "repair engine adds fresh dispatch flag on stale claim", "fail_if": ["repair_action.next_options.forceFreshDispatch != true"] },
    { "id": "TC011", "lane": "image", "category": "quality", "description": "non-repairable validator fail", "fail_if": ["repair_action.repairable != false"] },
    { "id": "TC012", "lane": "image", "category": "lineage", "description": "retry creates suffixed job id", "fail_if": ["retry_task.job_id missing _R02 suffix"] },
    { "id": "TC013", "lane": "image", "category": "trace", "description": "raw trace writes full_prompt.txt", "fail_if": ["trace.full_prompt.txt missing"] },
    { "id": "TC014", "lane": "image", "category": "trace", "description": "raw trace writes full_response.txt", "fail_if": ["trace.full_response.txt missing"] },
    { "id": "TC015", "lane": "image", "category": "trace", "description": "raw trace writes analyzer_full.json", "fail_if": ["trace.analyzer_full.json missing"] },
    { "id": "TC016", "lane": "image", "category": "trace", "description": "raw trace writes judge_full.json", "fail_if": ["trace.judge_full.json missing"] },
    { "id": "TC017", "lane": "image", "category": "loop", "description": "outer loop stops after allow", "fail_if": ["attempt_count > 1 when first attempt allows"] },
    { "id": "TC018", "lane": "image", "category": "loop", "description": "outer loop retries repairable timeout once", "fail_if": ["attempt_count != 2"] },
    { "id": "TC019", "lane": "image", "category": "trace", "description": "outer loop records failure_route", "fail_if": ["failure_route missing on rejected attempt"] },
    { "id": "TC020", "lane": "image", "category": "memory", "description": "memory write happens after outer loop finalization", "fail_if": ["run_history final entry missing final decision"] },
    { "id": "TC021", "lane": "image", "category": "canon", "description": "canon fail classified as canon", "fail_if": ["failure_router.repair_class != canon"] },
    { "id": "TC022", "lane": "image", "category": "quality", "description": "material read fail classified", "fail_if": ["failure_router.failure_type != material_read_fail"] },
    { "id": "TC023", "lane": "image", "category": "quality", "description": "abstract composition classified", "fail_if": ["failure_router.failure_type != abstract_composition"] },
    { "id": "TC024", "lane": "image", "category": "quality", "description": "unreadable object classified", "fail_if": ["failure_router.failure_type != unreadable_object"] },
    { "id": "TC025", "lane": "image", "category": "quality", "description": "texture only frame classified", "fail_if": ["failure_router.failure_type != texture_only_frame"] },
    { "id": "TC026", "lane": "image", "category": "quality", "description": "drift fail classified", "fail_if": ["failure_router.failure_type != drift_fail"] },
    { "id": "TC027", "lane": "image", "category": "runtime", "description": "reread result grace configured", "fail_if": ["repair_action.next_options.rereadResultGraceMs missing for malformed result"] },
    { "id": "TC028", "lane": "image", "category": "runtime", "description": "stale claim cleanup configured", "fail_if": ["repair_action.next_options.cleanupStaleClaim != true"] },
    { "id": "TC029", "lane": "image", "category": "quality", "description": "prompt reinforcement emitted", "fail_if": ["repair_action.prompt_patch.positive_additions empty for readability fail"] },
    { "id": "TC030", "lane": "image", "category": "quality", "description": "anti abstract reinforcement emitted", "fail_if": ["repair_action.prompt_patch.negative_additions missing abstract composition"] },
    { "id": "TC031", "lane": "image", "category": "quality", "description": "material reinforcement emitted", "fail_if": ["repair_action.actions missing material_reinforcement"] },
    { "id": "TC032", "lane": "image", "category": "quality", "description": "drift negative injection emitted", "fail_if": ["repair_action.actions missing drift_negative_injection"] },
    { "id": "TC033", "lane": "image", "category": "canon", "description": "canon lock boost emitted", "fail_if": ["repair_action.actions missing canon_lock_boost"] },
    { "id": "TC034", "lane": "image", "category": "canon", "description": "must-have replay emitted", "fail_if": ["repair_action.canon_patch.must_have_replay empty"] },
    { "id": "TC035", "lane": "image", "category": "lineage", "description": "retry lineage artifact written", "fail_if": ["trace.retry_lineage.json missing"] },
    { "id": "TC036", "lane": "image", "category": "trace", "description": "failure_route artifact written", "fail_if": ["trace.failure_route.json missing"] },
    { "id": "TC037", "lane": "image", "category": "trace", "description": "repair_action artifact written", "fail_if": ["trace.repair_action.json missing"] },
    { "id": "TC038", "lane": "image", "category": "trace", "description": "final decision snapshot written", "fail_if": ["trace.final_decision_snapshot.json missing"] },
    { "id": "TC039", "lane": "image", "category": "loop", "description": "hard stop on max retry cap", "fail_if": ["repair_action.notes missing Max retry cap reached."] },
    { "id": "TC040", "lane": "image", "category": "loop", "description": "hard stop on non-repairable failure", "fail_if": ["repair_action.repairable != false for non-repairable failure"] }
