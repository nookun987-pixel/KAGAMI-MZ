  "lighting_rules": {
    "no_bloom_into_garment": true,
    "no_spill_into_face_shadow": true,
    "not_primary_key_light": true,
    "requires_crisp_edge": true
  },
  "validation_logic": {
    "pass": "Sampled protected Z-Blue zones match master swatch within configured tolerance and show no contamination",
    "fail": "Any hue/saturation/value contamination, distortion contact, cast shift, spill, or uncontrolled bloom in protected zones"
  }
