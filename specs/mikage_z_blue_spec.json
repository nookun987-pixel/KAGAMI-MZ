  },
  "usage_zones": [
    {
      "zone": "cine_material_temperature",
      "description": "Muted non-emissive cool steel / low-temp oxidized titanium read",
      "protection_level": "CRITICAL"
    },
    {
      "zone": "rim_or_shadow_temperature",
