  "replaces": "cold cyan",
  "forbidden": [
    "spectral blue",
    "neon blue",
    "#0000* blue range as Z-Blue",
    "brand/UI surface usage"
  ],
  "master_swatch": {
    "hex": "#4B5866",
    "rgb": { "r": 75, "g": 88, "b": 102 },
